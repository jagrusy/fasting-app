# Set up once locally with `bundle exec fastlane match init`, then replace the placeholder URL
# below with the private git repo it creates. See FASTLANE_SETUP.md, "Set up code signing (match)".
git_url(ENV["MATCH_GIT_URL"] || "https://github.com/jagrusy/fasting-app-certificates.git")
storage_mode("git")
type("appstore")
app_identifier(["com.grusy.SolsticeFast"])
username(ENV["APPLE_ID"] || "jagrusy@gmail.com")

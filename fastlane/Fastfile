require 'tmpdir'
require 'fileutils'

default_platform(:ios)

# Copies the profile get_provisioning_profile just downloaded into every directory Xcode might
# read provisioning profiles from, named by UUID, and returns that UUID.
#
# fastlane's install_provisioning_profile targets ~/Library/MobileDevice/Provisioning Profiles,
# but Xcode 16 reads from ~/Library/Developer/Xcode/UserData/Provisioning Profiles — which is why
# a profile could install "successfully" and still come back as "No profile ... found" at archive
# time. Writing both costs nothing and is version-agnostic. Referencing the profile by UUID
# rather than name also avoids depending on Apple's generated display name matching exactly.
def install_appstore_profile_everywhere
  source = lane_context[SharedValues::SIGH_PROFILE_PATH]
  uuid = lane_context[SharedValues::SIGH_UUID]
  UI.user_error!("get_provisioning_profile did not set a profile path/UUID") if source.nil? || uuid.nil?

  [
    File.join(Dir.home, "Library/MobileDevice/Provisioning Profiles"),
    File.join(Dir.home, "Library/Developer/Xcode/UserData/Provisioning Profiles")
  ].each do |dir|
    FileUtils.mkdir_p(dir)
    FileUtils.cp(source, File.join(dir, "#{uuid}.mobileprovision"))
  end

  UI.success("Installed provisioning profile #{uuid} for manual signing")
  uuid
end

# Reads the team ID out of the provisioning profile Apple just issued.
#
# Preferred over the APPLE_TEAM_ID secret because the profile and the signing certificate are
# necessarily from the same team (Apple issued the profile against that certificate), whereas the
# secret is hand-entered and can drift. A mismatch shows up as the thoroughly unhelpful
# "Provisioning profile ... belongs to team X, which does not match the selected team Y".
def team_id_from_profile
  path = lane_context[SharedValues::SIGH_PROFILE_PATH]
  plist_path = File.join(Dir.tmpdir, "profile-#{Process.pid}.plist")
  system("security cms -D -i '#{path}' -o '#{plist_path}' 2>/dev/null")
  team = `plutil -extract TeamIdentifier.0 raw -o - '#{plist_path}' 2>/dev/null`.strip
  FileUtils.rm_f(plist_path)
  team = nil if team.empty?

  if team.nil?
    UI.important("Could not read TeamIdentifier from the profile; falling back to APPLE_TEAM_ID")
    team = ENV["APPLE_TEAM_ID"]
  elsif ENV["APPLE_TEAM_ID"] && ENV["APPLE_TEAM_ID"] != team
    UI.important("APPLE_TEAM_ID (#{ENV['APPLE_TEAM_ID']}) does not match the team that owns the " \
                 "provisioning profile (#{team}). Using #{team} — consider correcting the secret.")
  end

  UI.user_error!("Could not determine a team ID for signing") if team.to_s.empty?
  team
end

# Answers the questions App Review asks of every new app up front, in the Notes field.
#
# The first submission was rejected under Guideline 2.1 (Information Needed) asking for the
# app's functions, target audience, setup/demo instructions, external services, regional
# differences and regulated-industry status. Keeping the answers here means every future
# submission carries them automatically instead of relying on someone remembering.
#
# Apple also asks for a screen recording made on a physical device. That cannot be produced
# from CI and has to be attached by a human in the App Review conversation.
def app_review_notes
  devices = ENV["APP_REVIEW_TEST_DEVICES"] || "iPhone (physical device) running iOS 26, via TestFlight"

  <<~NOTES
    WHAT SOLSTICE IS
    An intermittent fasting timer. The user starts a fast, the app counts elapsed time against
    a target duration (12:12, 14:10, 16:8, 18:6, 20:4 or 23:1 OMAD), and saves completed fasts
    to a local history with streaks and a monthly calendar heatmap.

    ATTACHED SCREEN RECORDING
    Solstice has none of the flows below, so the recording does not include them:
    - Account registration, login, or account deletion: none, the app has no accounts.
    - Paid content, purchases, or subscriptions: none, the app is free with no in-app purchases.
    - User-generated content, reporting, or blocking: none, there is no shared or user-generated
      content of any kind — all data is private and local to the device.
    - Prompts for sensitive data or device capabilities: none. Solstice never requests location,
      contacts, camera, or App Tracking Transparency. The only permission it can ever prompt for
      is local notifications, and only if the user turns on reminders in Settings.

    TARGET AUDIENCE
    Adults who practise time-restricted eating and want a simple, private timer and habit
    tracker. This is a general wellness app. It gives no medical advice, makes no diagnostic or
    treatment claims, and shows a medical disclaimer in Settings.

    NO ACCOUNT, NO PURCHASES
    There is no sign-up, sign-in or account of any kind, and no paid content, subscriptions or
    in-app purchases. Every feature is available immediately on first launch. There are no demo
    credentials to supply because there is nothing to log in to.

    HOW TO EXERCISE EVERY FEATURE
    1. Fast tab: tap "Start Fast". The ring shows progress. Tap the centre to cycle between
       Elapsed / Remaining / Percentage. Drag the knob on the ring to adjust the start time in
       5-minute steps. Tap the badge under the ring for the metabolic stage explanations.
    2. Tap "End Fast" to finish, then choose "Save Fast" to record it or "Discard Fast" to
       throw it away.
    3. History tab: completed fasts, current and best streak, and a monthly heatmap. Tap any
       row to edit its start/end times or delete it.
    4. Settings tab: change the fasting protocol, switch appearance (light/dark/system),
       enable notification reminders, read the medical disclaimer, erase all data.

    DEVICES AND OS TESTED
    #{devices}. Also exercised on the iOS 26 Simulator across iPhone 17 Pro, 17 Pro Max and
    13 Pro Max, with automated unit and UI test suites run on every commit.

    EXTERNAL SERVICES
    None. Solstice makes no network requests. There is no backend, no accounts, no analytics,
    no advertising and no third-party tracking SDKs. All data is stored on-device using Core
    Data. The only outbound links are ordinary Safari links to public health articles (Johns
    Hopkins, Harvard Health, Mayo Clinic) and a mailto: feedback link, all inside Settings.

    PERMISSIONS
    Local notifications only, and only if the user turns reminders on in Settings. The app does
    not request location, camera, microphone, contacts, photos, or App Tracking Transparency.

    REGIONAL DIFFERENCES
    None. Behaviour is identical in every territory. The app ships in English (U.S.) and uses
    the device locale only for formatting dates and times.

    REGULATED INDUSTRY
    Not applicable. Solstice is a general wellness timer, not a medical device, and provides no
    protected or third-party regulated content.
  NOTES
end

platform :ios do
  desc "Run full test suite (Unit & UI tests)"
  lane :test do
    run_tests(
      project: "Fasted.xcodeproj",
      scheme: "FastedTests",
      devices: ["iPhone 17 Pro Max"],
      clean: true
    )
  end

  desc "Capture production App Store screenshots"
  lane :screenshots do
    # No device argument: the script's own defaults capture every display size App Store
    # Connect requires (6.9" and 6.5"). Passing one device here would silently fill only one
    # slot and the submission would be rejected for a missing size.
    sh("../scripts/generate_screenshots.sh")
  end

  desc "Replace App Store screenshots only - no build, no metadata, no resubmission"
  lane :screenshots_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # deliver seeds its per-slot "already uploaded" counter from App Store Connect *before*
    # overwrite_screenshots runs its delete, so within a single invocation the counter stays
    # stale and it starts refusing uploads once the pre-delete count is reached — silently
    # dropping the last screenshots and leaving a mix of old and new on the listing.
    #
    # Running the upload twice works around it: the first pass clears the slots, and the
    # second pass starts from an accurate (lower) count and gets the full set through.
    2.times do |attempt|
      UI.message("Screenshot upload pass #{attempt + 1} of 2...")
      deliver(
        api_key: api_key,
        force: true,
        screenshots_path: "./fastlane/screenshots",
        overwrite_screenshots: true,
        skip_screenshots: false,
        skip_binary_upload: true,
        skip_metadata: true,
        submit_for_review: false,
        precheck_include_in_app_purchases: false
      )
    end
  end

  desc "Build and upload to TestFlight (Beta)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Fetch the App Store distribution profile, then sign manually against it.
    #
    # Automatic signing does not work on this runner: it insists on a *development* identity for
    # the archive step ("Xcode couldn't find any iOS App Development provisioning profiles"),
    # but the CI keychain only holds the distribution certificate — and supplying a distribution
    # identity alongside it just yields "conflicting provisioning settings". Manual signing with
    # an explicitly fetched distribution profile is the combination that matches what CI has.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.grusy.SolsticeFast"
    )
    profile_uuid = install_appstore_profile_everywhere
    team_id = team_id_from_profile

    # Apple rejects an upload whose CFBundleVersion was already used, so take the next one
    # after whatever TestFlight already has rather than the static value in Info.plist.
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.grusy.SolsticeFast",
      initial_build_number: 0
    ) + 1
    UI.message("Building as build number #{build_number}")

    build_app(
      project: "Fasted.xcodeproj",
      scheme: "Fasted",
      clean: true,
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" " \
              "PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid} DEVELOPMENT_TEAM=#{team_id} " \
              "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { "com.grusy.SolsticeFast" => profile_uuid }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload to TestFlight using your local Xcode signing (no CI secrets needed)"
  lane :beta_local do
    team_id = ENV["APPLE_TEAM_ID"]
    UI.user_error!(
      "Set APPLE_TEAM_ID first, e.g. `APPLE_TEAM_ID=ABCDE12345 bundle exec fastlane beta_local`. " \
      "Find your team ID at https://developer.apple.com/account under Membership."
    ) if team_id.nil? || team_id.empty?

    # No app_store_connect_api_key and no get_provisioning_profile step: this relies entirely on
    # the Apple ID already signed in to Xcode (Xcode > Settings > Accounts) on this machine, with
    # -allowProvisioningUpdates letting xcodebuild create/renew the distribution certificate and
    # App Store provisioning profile itself. That's the CI deploy workflow's actual blocker — it
    # has no certificate and nothing signed in to create one. upload_to_testflight below will
    # prompt interactively for your Apple ID / 2FA the first time; after that it reuses your
    # local fastlane session.
    build_app(
      project: "Fasted.xcodeproj",
      scheme: "Fasted",
      clean: true,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates -allowProvisioningDeviceRegistration " \
              "CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=#{team_id}",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload metadata, screenshots, and submit build to App Store for review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Fetch the App Store distribution profile, then sign manually against it.
    #
    # Automatic signing does not work on this runner: it insists on a *development* identity for
    # the archive step ("Xcode couldn't find any iOS App Development provisioning profiles"),
    # but the CI keychain only holds the distribution certificate — and supplying a distribution
    # identity alongside it just yields "conflicting provisioning settings". Manual signing with
    # an explicitly fetched distribution profile is the combination that matches what CI has.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.grusy.SolsticeFast"
    )
    profile_uuid = install_appstore_profile_everywhere
    team_id = team_id_from_profile

    # Apple rejects an upload whose CFBundleVersion was already used, so take the next one
    # after whatever TestFlight already has rather than the static value in Info.plist.
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.grusy.SolsticeFast",
      initial_build_number: 0
    ) + 1
    UI.message("Building as build number #{build_number}")

    build_app(
      project: "Fasted.xcodeproj",
      scheme: "Fasted",
      clean: true,
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" " \
              "PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid} DEVELOPMENT_TEAM=#{team_id} " \
              "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { "com.grusy.SolsticeFast" => profile_uuid }
      }
    )

    # Apple requires review-contact info before a submission is accepted. Solstice has no
    # accounts/login, so sign_in_required is false and there's nothing to demo-log-in with.
    review_phone = ENV["APP_REVIEW_PHONE"]
    UI.user_error!(
      "Set APP_REVIEW_PHONE (App Review contact phone number, e.g. +15551234567) before " \
      "running the release lane — Apple requires it to accept a submission."
    ) if review_phone.nil? || review_phone.empty?

    deliver(
      api_key: api_key,
      force: true,
      screenshots_path: "./fastlane/screenshots",
      metadata_path: "./fastlane/metadata",
      skip_metadata: false,
      skip_screenshots: false,
      # Replace the existing set rather than appending to it. Without this, deliver adds to
      # whatever is already on App Store Connect, and once the combined count passes Apple's
      # per-device limit the extras are silently dropped — which is how 05 and 06 went missing
      # with only six screenshots in the folder.
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      # precheck can't inspect in-app purchases when authenticating with an App Store Connect
      # API key, and fails the whole submission over it. Solstice has no IAP at all (no
      # subscriptions, no paywalls), so there is nothing for this check to look at.
      precheck_include_in_app_purchases: false,
      app_review_information: {
        first_name: ENV["APP_REVIEW_FIRST_NAME"] || "Alan",
        last_name: ENV["APP_REVIEW_LAST_NAME"] || "Grusy",
        phone_number: review_phone,
        email_address: ENV["APP_REVIEW_EMAIL"] || "jagrusy@gmail.com",
        notes: app_review_notes
        # No demo_user/demo_password: nothing to log into (no accounts in the app at all).
      }
    )
  end
end

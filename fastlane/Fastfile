require 'base64'
require 'tmpdir'

default_platform(:ios)

# Writes the App Store Connect API key to a real file so xcodebuild can authenticate with Apple
# directly (-authenticationKeyPath). Returns an absolute path; xcodebuild rejects relative ones.
def app_store_connect_key_file
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
  content = ENV["APP_STORE_CONNECT_KEY_CONTENT"]
  UI.user_error!("APP_STORE_CONNECT_KEY_ID / _KEY_CONTENT must be set") if key_id.to_s.empty? || content.to_s.empty?

  path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
  File.write(path, Base64.decode64(content))
  File.chmod(0o600, path)
  path
end

platform :ios do
  desc "Run full test suite (Unit & UI tests)"
  lane :test do
    run_tests(
      project: "Fasted.xcodeproj",
      scheme: "FastedTests",
      devices: ["iPhone 17 Pro"],
      clean: true
    )
  end

  desc "Capture production App Store screenshots"
  lane :screenshots do
    sh("../scripts/generate_screenshots.sh 'iPhone 17 Pro'")
  end

  desc "Build and upload to TestFlight (Beta)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    team_id = ENV["APPLE_TEAM_ID"]

    # Automatic signing, authenticating to Apple with the App Store Connect API key directly.
    # This is Apple's supported CI path: -authenticationKey* lets xcodebuild create and download
    # provisioning profiles itself, with no Xcode GUI account and no separate fetch/install dance.
    #
    # We previously drove this by hand (get_provisioning_profile -> install_provisioning_profile
    # -> manual signing) and hit a different failure at every layer, ending with xcodebuild
    # reporting "No profile ... found" for a profile that had just been installed successfully —
    # Xcode 16 reads profiles from a different directory than fastlane's installer writes to.
    # Letting xcodebuild own profile management end to end removes that whole class of problem.
    # The signing *certificate* still has to be in the keychain; the workflow's
    # "Import Code-Signing Certificate" step puts it there.
    build_app(
      project: "Fasted.xcodeproj",
      scheme: "Fasted",
      clean: true,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{app_store_connect_key_file} " \
              "-authenticationKeyID #{ENV['APP_STORE_CONNECT_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_ISSUER_ID']} " \
              "CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=#{team_id}",
      export_xcargs: "-allowProvisioningUpdates " \
                     "-authenticationKeyPath #{app_store_connect_key_file} " \
                     "-authenticationKeyID #{ENV['APP_STORE_CONNECT_KEY_ID']} " \
                     "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_ISSUER_ID']}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload to TestFlight using your local Xcode signing (no CI secrets needed)"
  lane :beta_local do
    team_id = ENV["APPLE_TEAM_ID"]
    UI.user_error!(
      "Set APPLE_TEAM_ID first, e.g. `APPLE_TEAM_ID=ABCDE12345 bundle exec fastlane beta_local`. " \
      "Find your team ID at https://developer.apple.com/account under Membership."
    ) if team_id.nil? || team_id.empty?

    # No app_store_connect_api_key and no get_provisioning_profile step: this relies entirely on
    # the Apple ID already signed in to Xcode (Xcode > Settings > Accounts) on this machine, with
    # -allowProvisioningUpdates letting xcodebuild create/renew the distribution certificate and
    # App Store provisioning profile itself. That's the CI deploy workflow's actual blocker — it
    # has no certificate and nothing signed in to create one. upload_to_testflight below will
    # prompt interactively for your Apple ID / 2FA the first time; after that it reuses your
    # local fastlane session.
    build_app(
      project: "Fasted.xcodeproj",
      scheme: "Fasted",
      clean: true,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates -allowProvisioningDeviceRegistration " \
              "CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=#{team_id}",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload metadata, screenshots, and submit build to App Store for review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    team_id = ENV["APPLE_TEAM_ID"]

    # Automatic signing, authenticating to Apple with the App Store Connect API key directly.
    # This is Apple's supported CI path: -authenticationKey* lets xcodebuild create and download
    # provisioning profiles itself, with no Xcode GUI account and no separate fetch/install dance.
    #
    # We previously drove this by hand (get_provisioning_profile -> install_provisioning_profile
    # -> manual signing) and hit a different failure at every layer, ending with xcodebuild
    # reporting "No profile ... found" for a profile that had just been installed successfully —
    # Xcode 16 reads profiles from a different directory than fastlane's installer writes to.
    # Letting xcodebuild own profile management end to end removes that whole class of problem.
    # The signing *certificate* still has to be in the keychain; the workflow's
    # "Import Code-Signing Certificate" step puts it there.
    build_app(
      project: "Fasted.xcodeproj",
      scheme: "Fasted",
      clean: true,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{app_store_connect_key_file} " \
              "-authenticationKeyID #{ENV['APP_STORE_CONNECT_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_ISSUER_ID']} " \
              "CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=#{team_id}",
      export_xcargs: "-allowProvisioningUpdates " \
                     "-authenticationKeyPath #{app_store_connect_key_file} " \
                     "-authenticationKeyID #{ENV['APP_STORE_CONNECT_KEY_ID']} " \
                     "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_ISSUER_ID']}"
    )

    # Apple requires review-contact info before a submission is accepted. Solstice has no
    # accounts/login, so sign_in_required is false and there's nothing to demo-log-in with.
    review_phone = ENV["APP_REVIEW_PHONE"]
    UI.user_error!(
      "Set APP_REVIEW_PHONE (App Review contact phone number, e.g. +15551234567) before " \
      "running the release lane — Apple requires it to accept a submission."
    ) if review_phone.nil? || review_phone.empty?

    deliver(
      api_key: api_key,
      force: true,
      screenshots_path: "./fastlane/screenshots",
      metadata_path: "./fastlane/metadata",
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: true,
      automatic_release: true,
      app_review_information: {
        first_name: ENV["APP_REVIEW_FIRST_NAME"] || "Alan",
        last_name: ENV["APP_REVIEW_LAST_NAME"] || "Grusy",
        phone_number: review_phone,
        email_address: ENV["APP_REVIEW_EMAIL"] || "jagrusy@gmail.com",
        notes: "Solstice has no accounts or sign-in — every feature is reachable immediately."
        # No demo_user/demo_password: nothing to log into (no accounts in the app at all).
      }
    )
  end
end
